# 접속 비밀번호 (숫자 4자리)
SITE_PIN=
# 쿠키 서명용 비밀값 (16자 이상, 예: openssl rand -hex 24)
AUTH_SECRET=
# 네이버 클라우드 플랫폼 Maps Client ID — 비워 두면 내장 SVG 지도로 표시
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Supabase Postgres — Transaction pooler(6543) 연결 문자열. 비밀번호 특수문자는 퍼센트 인코딩
DATABASE_URL=
# 공공데이터포털 일반 인증키(Decoding) — 국토교통부 아파트 매매·전월세 실거래가 API
DATA_GO_KR_SERVICE_KEY=
# 서울 열린데이터광장 인증키 — 지하철 역사마스터
SEOUL_OPEN_API_KEY=
# NEIS 교육정보 개방 포털 인증키 — 학교·학원 정보
NEIS_API_KEY=
# NAVER API HUB (NCP) 검색 API — 구별 관련 기사
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
