# 로그인 세션 쿠키 서명용 비밀값 (16자 이상, 예: openssl rand -hex 24). 바꾸면 모든 세션이 끊긴다
AUTH_SECRET=
# 가입 초대 코드. 이 코드를 아는 사람만 가입할 수 있다 (비우면 가입 막힘)
INVITE_CODE=
# 네이버 클라우드 플랫폼 Maps Client ID — 비워 두면 내장 SVG 지도로 표시
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Supabase Postgres — Session pooler(5432) 연결 문자열 (Transaction pooler 6543 은 동시 요청 때 쿼리가 멈춘다). 비밀번호 특수문자는 퍼센트 인코딩
DATABASE_URL=
# 공공데이터포털 일반 인증키(Decoding) — 국토교통부 아파트 매매·전월세 실거래가 API
DATA_GO_KR_SERVICE_KEY=
# 서울 열린데이터광장 인증키 — 지하철 역사마스터
SEOUL_OPEN_API_KEY=
# NEIS 교육정보 개방 포털 인증키 — 학교·학원 정보
NEIS_API_KEY=
# NAVER API HUB (NCP) 검색 API — 구별 관련 기사
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 한국부동산원 R-ONE 부동산통계 Open API 인증키 — 주간 아파트 가격 변동률
R_ONE_API_KEY=
# Vercel Cron 요청 확인용 비밀값 (16자 이상, 예: openssl rand -hex 24). Vercel 이 Authorization 헤더로 보낸다
CRON_SECRET=
